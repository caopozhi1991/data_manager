login(`admin, `123456)

// 定义数据库路径
minuteDbPath = "dfs://ohlcv_minute"

// 定义分钟线表通用结构
sch_minute = table(
    1:0,
    `symbol`name`trade_date`trade_time`open`high`low`close`volume`amount`adjust_factor,
    [`SYMBOL, `STRING, `DATE, `TIMESTAMP, `DOUBLE, `DOUBLE, `DOUBLE, `DOUBLE, `INT, `DOUBLE, `DOUBLE]
)

// 生成按天分区的日期范围（2020.01.01 到 2030.12.31）
// 使用 VALUE 分区，每个日期一个独立分区
startDate = date(2020.01.01)
endDate = date(2030.12.31)
dayPartitions = startDate .. endDate   // 生成连续的日期序列

// 创建分钟数据库（如果不存在），采用 VALUE 分区，按天
if(!existsDatabase(minuteDbPath)) {
    db_minute = database(minuteDbPath, VALUE, dayPartitions, , "OLAP")
} else {
    db_minute = database(minuteDbPath)
}

// 定义各周期表名
periods = ["1m", "5m", "15m", "30m", "60m"]
// 使用 for 循环替代 foreach
for (p in periods) {
    tableName = "stock_kline_" + p
    if(!existsTable(minuteDbPath, tableName)) {
        db_minute.createPartitionedTable(sch_minute, tableName, `trade_date)
        print("表 " + tableName + " 创建成功")
    } else {
        print("表 " + tableName + " 已存在")
    }
}