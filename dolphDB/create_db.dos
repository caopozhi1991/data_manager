login(`admin, `123456)

// 定义按年分区的边界（左闭右开）
// 从 2000.01.01 到 2031.01.01，自动形成 2000-2030 这31个年份分区
partitionBounds = [2020.01.01, 2021.01.01, 2022.01.01, 2023.01.01, 2024.01.01, 2025.01.01, 2026.01.01, 2027.01.01, 2028.01.01, 2029.01.01, 2030.01.01, 2031.01.01]

// 1. 创建数据库（如果存在则先删除）
if(existsDatabase("dfs://ohlcv_daily")) dropDatabase("dfs://ohlcv_daily")
db_daily = database("dfs://ohlcv_daily", RANGE, partitionBounds, , "OLAP")